diff --git a/custom/build-linux.sh b/custom/build-linux.sh
new file mode 100755
index 0000000..b3928f3
--- /dev/null
+++ b/custom/build-linux.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+VERSION="${1:-1.7.7}"
+HOST_ONLY="${HOST_ONLY:-n}"
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+
+cd "$ROOT"
+
+TOOLCHAIN_ARGS=()
+# Ubuntu 20.04 needs GCC 10 for the Slint C++ API; newer releases can use
+# their default toolchain.
+if command -v gcc-10 >/dev/null 2>&1; then
+  TOOLCHAIN_ARGS=(--toolchain=gcc-10)
+fi
+
+xmake f -c -m release --CROSSDESK_VERSION="$VERSION" --USE_CUDA=false \
+  --CROSSDESK_HOST_ONLY="$HOST_ONLY" ${TOOLCHAIN_ARGS[@]+"${TOOLCHAIN_ARGS[@]}"} -y
+xmake b -vy crossdesk
+
+ARCH="$(uname -m)"
+if [[ "$ARCH" == "aarch64" || "$ARCH" == "arm64" ]]; then
+  ./apps/desktop/scripts/linux/pkg_arm64.sh "$VERSION"
+else
+  ./apps/desktop/scripts/linux/pkg_amd64.sh "$VERSION"
+fi
