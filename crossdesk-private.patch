--- /dev/null
+++ b/custom/build-macos.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+VERSION="${1:-1.7.7}"
+HOST_ONLY="${HOST_ONLY:-n}"
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+
+cd "$ROOT"
+xmake f -c -m release --target_minver=14.0 \
+  --CROSSDESK_VERSION="$VERSION" --USE_CUDA=false \
+  --CROSSDESK_HOST_ONLY="$HOST_ONLY" -y
+xmake b -vy crossdesk
+
+if [[ "$(uname -m)" == "arm64" ]]; then
+  ./apps/desktop/scripts/macos/pkg_arm64.sh "$VERSION"
+else
+  ./apps/desktop/scripts/macos/pkg_x64.sh "$VERSION"
+fi
diff --git a/custom/build-windows.ps1 b/custom/build-windows.ps1
new file mode 100644
index 0000000..fa659b5
--- /dev/null
+++ b/custom/build-windows.ps1
@@ -0,0 +1,24 @@
+param(
+  [string]$Version = "1.7.7",
+  [switch]$HostOnly
+)
+
+$ErrorActionPreference = "Stop"
+$root = Split-Path -Parent $PSScriptRoot
+$hostOnlyFlag = if ($HostOnly) { "y" } else { "n" }
+
+Push-Location $root
+try {
+  xmake f -c -p windows -a x64 -m release `
+    "--CROSSDESK_VERSION=$Version" --USE_CUDA=false `
+    "--CROSSDESK_HOST_ONLY=$hostOnlyFlag" -y
+  if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+
+  xmake b -vy crossdesk
+  if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+
+  & "$root\apps\desktop\scripts\windows\pkg_x64.ps1" $Version
+  if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+} finally {
+  Pop-Location
+}
