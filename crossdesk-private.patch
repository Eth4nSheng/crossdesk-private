diff --git a/apps/desktop/src/config_center/custom_build.h b/apps/desktop/src/config_center/custom_build.h
new file mode 100644
index 0000000..27c69ee
--- /dev/null
+++ b/apps/desktop/src/config_center/custom_build.h
@@ -0,0 +1,17 @@
+#ifndef _CUSTOM_BUILD_H_
+#define _CUSTOM_BUILD_H_
+
+// Private deployment defaults.
+//
+// These values seed a fresh configuration and are applied once to an existing
+// configuration file when kCustomDefaultsVersion is bumped. Users can still
+// change the server in Settings afterwards; this file only provides defaults.
+namespace crossdesk {
+inline constexpr bool kCustomSelfHostedDefault = true;
+inline constexpr const char *kCustomSignalServerHost = "47.101.34.130";
+inline constexpr int kCustomSignalServerPort = 9099;
+// Bump this to re-apply the defaults to configurations created by an older build.
+inline constexpr long kCustomDefaultsVersion = 1;
+}  // namespace crossdesk
+
+#endif  // _CUSTOM_BUILD_H_
